DROP TABLE IF EXISTS `0_ksf_import_square_statements`;
DROP TABLE IF EXISTS `0_ksf_import_square_transactions`;
DROP TABLE IF EXISTS `0_ksf_import_square_partners_data`;

CREATE TABLE `0_ksf_import_square_statements` (
    `id`			INTEGER NOT NULL AUTO_INCREMENT,
    `bank`			VARCHAR(64),
    `account`			VARCHAR(64),
    `currency`			VARCHAR(3),
    `startBalance`		DOUBLE,
    `endBalance`		DOUBLE,
    `smtDate`			DATE,
    `number`			INTEGER,
    `seq`			INTEGER,
    `statementId`		VARCHAR(64),
    PRIMARY KEY(`id`),
    CONSTRAINT `unique_smt` UNIQUE(`bank`, `statementId`)
);

CREATE TABLE `0_ksf_import_square_transactions` (
    `id`			INTEGER NOT NULL AUTO_INCREMENT,
        Date                     date        NOT NULL                              ,
        Time                     varchar(8)  NOT NULL                              ,
        Timezone                 varchar(64) NOT NULL                              ,
        gross_sales              float       NOT NULL                              ,
        discounts                float       NOT NULL                              ,
        service_charges          float       NOT NULL                              ,
        gift_card_sales          float       NOT NULL                              ,
        net_sales                float       NOT NULL                              ,
        tax                      float       NOT NULL                              ,
        tip                      float       NOT NULL                              ,
        partial_refunds          float       NOT NULL                              ,
        total_collected          float       NOT NULL                              ,
        source                   varchar(16) NOT NULL                              ,
        card                     float       NOT NULL                              ,
        card_entry_methods       varchar(16) NOT NULL                              ,
        cash                     float       NOT NULL                              ,
        square_gift_card         float       NOT NULL                              ,
        other_tender             float       NOT NULL                              ,
        other_tender_type        varchar(16) NOT NULL                              ,
        other_tender_note        varchar(32) NOT NULL                              ,
        fees                     float       NOT NULL                              ,
        net_total                float       NOT NULL                              ,
        transaction_id           varchar(32) NOT NULL                              ,
        payment_id               varchar(32) NOT NULL                              ,
        card_brand               varchar(16) NOT NULL                              ,
        PAN_suffix               int(11)     NOT NULL                              ,
        device_name              varchar(32) NOT NULL                              ,
        staff_name               varchar(16) NOT NULL                              ,
        staff_id                 varchar(16) NOT NULL                              ,
        description              varchar(64) NOT NULL                              ,
        details                  varchar(64) NOT NULL                              ,
        event_type               varchar(32) NOT NULL                              ,
        location                 varchar(32) NOT NULL                              ,
        Dining_option            varchar(16) NOT NULL                              ,
        Customer_id              int(11)     NOT NULL                              ,
        customer_name            varchar(64) NOT NULL                              ,
        customer_reference_id    varchar(16) NOT NULL                              ,
        device_nickname          varchar(16) NOT NULL                              ,
        third_party_fees         float       NOT NULL                              ,
        deposit_id               varchar(32) NOT NULL                              ,
        deposit_date             date        NOT NULL                              ,
        deposit_details          varchar(64) NOT NULL                              ,
        fee_percentage_rate      float       NOT NULL                              ,
        fee_fixed_rate           float       NOT NULL                              ,
        refund_reason            varchar(64) NOT NULL                              ,
        discount_name            varchar(16) NOT NULL                              ,
        transaction_status       varchar(16) NOT NULL                              ,
        order_reference_id       varchar(16) NOT NULL                              ,
        fulfillment_note         varchar(32) NOT NULL                              ,
        free_processing_applied  float       NOT NULL                              ,
        last_updated             timestamp   NOT NULL       default current_timestamp()        ,
    PRIMARY KEY(`id`)
);


CREATE TABLE `0_ksf_import_square_partners_data` (
    `partner_id`		INTEGER,
    `partner_detail_id`		INTEGER,
    `partner_type`		INTEGER,
    `data`			varchar(256),
    CONSTRAINT `idx` UNIQUE(`partner_id`, `partner_detail_id`, `partner_type`)
);

DROP TABLE IF EXISTS `0_ksf_import_square_items`;
CREATE TABLE IF NOT EXISTS `0_ksf_import_square_items` (
  `id` int(11) NOT NULL AUTO_INCREMENT,
  `Date` date NOT NULL,
  `Time` varchar(8) NOT NULL,
  `Timezone` varchar(64) NOT NULL,
  `Category` varchar(32) NOT NULL,
  `Item` varchar(64) NOT NULL,
  `Price Point Name` varchar(32) NOT NULL,
  `stock_id` varchar(32) NOT NULL,
  `modifiers_applied` varchar(32) NOT NULL,
  `quantity` int(11) NOT NULL,
  `gross_sales` float NOT NULL,
  `discounts` float NOT NULL,
  `net_sales` float NOT NULL,
  `tax` float NOT NULL,
  `transaction_id` varchar(32) NOT NULL,
  `payment_id` varchar(32) NOT NULL,
  `device_name` varchar(32) NOT NULL,
  `notes` varchar(64) NOT NULL,
  `details` varchar(64) NOT NULL,
  `event_type` varchar(32) NOT NULL,
  `location` varchar(32) NOT NULL,
  `dining_option` varchar(16) NOT NULL,
  `Customer_id` int(11) NOT NULL,
  `customer_name` varchar(64) NOT NULL,
  `customer_reference_id` varchar(16) NOT NULL,
  `unit` varchar(16) NOT NULL,
  `count` float NOT NULL,
  `itemization_type` varchar(16) NOT NULL,
  `fulfillment_note` varchar(32) NOT NULL,
  `last_updated` timestamp NOT NULL DEFAULT current_timestamp(),
  PRIMARY KEY (`id`)
) ENGINE=InnoDB DEFAULT CHARSET=latin1;
